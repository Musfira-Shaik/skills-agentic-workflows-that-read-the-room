---
import BaseLayout from '../layouts/BaseLayout.astro';
import mona from '../../assets/mona.png';
import copilot from '../../assets/copilot.png';
import ducky from '../../assets/ducky.png';
import githubInfoMarkdown from '../../content/github-info.md?raw';

const publishedDateLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date());

function toPlainText(value) {
  return value
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[`*_]/g, '')
    .trim();
}

function extractDateFromText(value) {
  const match = value.match(
    /(January|February|March|April|May|June|July|August|September|October|November|December)\s+\d{1,2},\s+\d{4}|(January|February|March|April|May|June|July|August|September|October|November|December)\s+\d{4}/i
  );

  return match ? match[0] : '';
}

function getPostedDate({ sourceLabel, summary }) {
  const sourceDate = extractDateFromText(sourceLabel || '');
  if (sourceDate) {
    return sourceDate;
  }

  const summaryDate = extractDateFromText(summary || '');
  if (summaryDate) {
    return summaryDate;
  }

  return publishedDateLabel;
}

function getMarkdownSections(markdown) {
  const sections = [];
  let currentSection;

  for (const line of markdown.split('\n')) {
    if (line.startsWith('## ')) {
      if (currentSection) {
        sections.push(currentSection);
      }

      currentSection = {
        title: toPlainText(line.replace(/^##\s+/, '')),
        lines: [],
      };

      continue;
    }

    if (currentSection && !line.startsWith('# ')) {
      currentSection.lines.push(line);
    }
  }

  if (currentSection) {
    sections.push(currentSection);
  }

  return sections;
}

function splitSectionEntries(section) {
  const entries = [];
  let currentEntry = {
    title: section.title,
    lines: [],
  };

  for (const line of section.lines) {
    if (line.startsWith('### ')) {
      entries.push(currentEntry);
      currentEntry = {
        title: toPlainText(line.replace(/^###\s+/, '')),
        lines: [],
      };
      continue;
    }

    currentEntry.lines.push(line);
  }

  entries.push(currentEntry);
  return entries;
}

function isSourceLine(line) {
  const normalized = line.replace(/^>\s*/, '').trim();
  return /^\*?source:/i.test(normalized);
}

function isTableLine(line) {
  return /^\|.*\|$/.test(line);
}

function getEntryContent(entryLines) {
  const paragraphs = [];
  const bullets = [];

  for (const line of entryLines) {
    const trimmedLine = line.trim();

    if (!trimmedLine || isSourceLine(trimmedLine) || isTableLine(trimmedLine)) {
      continue;
    }

    if (trimmedLine.startsWith('- ')) {
      bullets.push(toPlainText(trimmedLine.replace(/^-\s+/, '')));
      continue;
    }

    paragraphs.push(toPlainText(trimmedLine.replace(/^>\s*/, '')));
  }

  return {
    paragraphs,
    bullets,
    summary: paragraphs[0] ?? bullets.join(' '),
  };
}

const contentUpdates = getMarkdownSections(githubInfoMarkdown)
  .flatMap((section) => splitSectionEntries(section).map((entry) => {
    const { paragraphs, bullets, summary } = getEntryContent(entry.lines);
    const sourceLine = entry.lines.find((line) => isSourceLine(line.trim()));
    const sourceLabel = sourceLine ? toPlainText(sourceLine.replace(/^\*?Source:\s*/i, '').replace(/^\*|\*$/g, '')) : '';
    const postedDate = getPostedDate({ sourceLabel, summary });

    return {
      type: 'EduHub update',
      date: postedDate,
      section: section.title,
      title: entry.title,
      summary,
      href: '#content-sources',
      bullets,
      sourceLabel,
      hasDetails: paragraphs.length > 0 || bullets.length > 0,
    };
  }))
  .filter((update) => update.summary && update.hasDetails)
  .map(({ hasDetails, ...update }) => update);

const latestContentUpdates = contentUpdates.filter((update) => update.section === 'Latest EduHub Updates');
const supportingContentUpdates = contentUpdates.filter((update) => update.section !== 'Latest EduHub Updates');

const latestMarkdownHighlight = latestContentUpdates.find(
  (update) => update.title !== 'Latest EduHub Updates'
);

const latestRelease = latestMarkdownHighlight
  ? {
    eyebrow: 'Latest platform highlight',
    title: latestMarkdownHighlight.title,
    date: latestMarkdownHighlight.date,
    summary: latestMarkdownHighlight.summary,
    href: '#recent-updates',
  }
  : {
    eyebrow: 'Latest platform highlight',
    title: 'EduHub onboarding now centralizes all student essentials',
    date: publishedDateLabel,
    summary:
      'EduHub brings academic information, study material, previous exam papers, and announcements into one accessible student platform.',
    href: '#content-sources',
  };

const recentUpdates = [
  {
    type: 'Student Services',
    date: 'August 2026',
    title: 'Centralized information desk',
    summary:
      'Students can now find course schedules, department contacts, and policy updates in one location.',
    href: '#content-sources',
  },
  {
    type: 'Learning Resources',
    date: 'August 2026',
    title: 'Material library by subject',
    summary:
      'Lecture notes, slides, recordings, and links are organized so students can revise faster.',
    href: '#content-sources',
  },
  {
    type: 'Exam Support',
    date: 'August 2026',
    title: 'Previous exam papers in one archive',
    summary:
      'Students can practice with earlier question papers using department and semester filters.',
    href: '#content-sources',
  },
  {
    type: 'Campus Announcements',
    date: 'August 2026',
    title: 'Announcement feed with priority notices',
    summary:
      'Deadline reminders and urgent updates are highlighted first so students never miss key information.',
    href: '#content-sources',
  },
];

const homepageUpdates = [
  ...latestContentUpdates,
  ...recentUpdates,
  ...supportingContentUpdates,
];

const sourceGroups = [
  {
    eyebrow: 'Core feature',
    title: 'Student information hub',
    description:
      'EduHub gives students one place for academic updates, course details, schedules, and faculty communication.',
    bullets: [
      'Department-wise notices and timelines in one dashboard.',
      'Quick access to syllabus summaries and course requirements.',
      'Important contacts available without searching multiple portals.',
    ],
    link: '#recent-updates',
    linkLabel: 'Explore dashboard updates',
  },
  {
    eyebrow: 'Core feature',
    title: 'Learning material library',
    description:
      'EduHub organizes lecture notes, slides, assignments, and recordings so study resources stay easy to find.',
    bullets: [
      'Resources grouped by semester and subject.',
      'Supports quick revision before quizzes and exams.',
      'Single place to access official study material.',
    ],
    link: '#recent-updates',
    linkLabel: 'Browse learning resources',
  },
  {
    eyebrow: 'Core feature',
    title: 'Exam papers and announcements',
    description:
      'EduHub combines previous exam papers and announcements so students can prepare and stay informed from a single platform.',
    bullets: [
      'Past papers searchable by department and semester.',
      'Pinned notices for urgent deadlines and changes.',
      'One stream for both academic and admin announcements.',
    ],
    link: '#recent-updates',
    linkLabel: 'Open exam and announcement section',
  },
];

const highlights = [
  {
    title: 'Everything in one place',
    text: 'EduHub gathers student information, learning material, exam papers, and announcements in one app.',
  },
  {
    title: 'Built for fast access',
    text: 'Students can quickly move from information to materials and papers without switching platforms.',
  },
  {
    title: 'Ready for daily use',
    text: 'Regular announcements and updates keep students informed throughout the semester.',
  },
];
---

<BaseLayout
  title="EduHub"
  description="EduHub is a learning platform for students to access information, materials, previous exam papers, and announcements in one place."
>
  <main class="page-shell">
    <section class="hero">
      <div class="hero__copy">
        <span class="eyebrow">EduHub student platform</span>
        <h1>Your information, materials, exam papers, and announcements in one place.</h1>
        <p class="lead">
          EduHub helps students stay on track by centralizing academic information and study resources in a
          single, easy-to-use learning platform.
        </p>

        <div class="hero__actions">
          <a class="button button--primary" href="#latest-release">View latest update</a>
          <a class="button button--ghost" href="#recent-updates">Explore student resources</a>
        </div>

        <div class="mini-stats">
          <article>
            <strong>1</strong>
            <span>featured platform update</span>
          </article>
          <article>
            <strong>{homepageUpdates.length}</strong>
            <span>student-focused update cards</span>
          </article>
          <article>
            <strong>3</strong>
            <span>core learning feature groups</span>
          </article>
        </div>
      </div>

      <div class="hero__visual">
        <div class="orb orb--pink"></div>
        <div class="orb orb--blue"></div>
        <div class="hero-card hero-card--mona">
          <img src={mona.src} alt="Student dashboard illustration" loading="eager" />
          <div>
            <p>Information</p>
            <span>One dashboard for schedules, contacts, and academic updates</span>
          </div>
        </div>
        <div class="hero-card hero-card--copilot">
          <img src={copilot.src} alt="Learning materials illustration" />
          <div>
            <p>Materials</p>
            <span>Course notes, slides, and recordings organized by subject</span>
          </div>
        </div>
        <div class="hero-card hero-card--ducky">
          <img src={ducky.src} alt="Announcements illustration" />
          <div>
            <p>Updates</p>
            <span>Previous exam papers and announcements available instantly</span>
          </div>
        </div>
      </div>
    </section>

    <section class="release-spotlight" id="latest-release">
      <div class="release-spotlight__copy">
        <span class="eyebrow">{latestRelease.eyebrow}</span>
        <h2>{latestRelease.title}</h2>
        <p class="release-spotlight__meta">{latestRelease.date}</p>
        <p>{latestRelease.summary}</p>
        <a class="button button--primary" href={latestRelease.href}>
          Read update details
        </a>
      </div>
      <div class="release-spotlight__media">
        <img src={copilot.src} alt="Learning platform update illustration" />
      </div>
    </section>

    <section class="updates" id="recent-updates">
      <div class="section-heading">
        <span class="eyebrow">What students can access</span>
        <h2>Platform updates and key student resources</h2>
        <p>
          EduHub surfaces updates from <code>site/content/github-info.md</code> so the homepage always reflects
          the latest student support information.
        </p>
      </div>

      <div class="updates-grid">
        {homepageUpdates.map((update) => (
          <article class="update-card">
            <span class:list={["pill", /announcement/i.test(update.type) ? 'pill--gold' : 'pill--violet']}>
              {update.type}
            </span>
            <p class="update-card__date">{update.date}</p>
            <h3>{update.title}</h3>
            <p>{update.summary}</p>
            {update.bullets?.length > 0 && (
              <ul>
                {update.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
            <a
              href={update.href}
              target={update.href.startsWith('#') ? undefined : '_blank'}
              rel={update.href.startsWith('#') ? undefined : 'noreferrer'}
            >
              {update.href.startsWith('#') ? 'Open platform section' : 'Read source details'}
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="highlights">
      {highlights.map((item) => (
        <article class="highlight-card">
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

    <section class="feature-band">
      <div class="feature-band__copy">
        <span class="eyebrow">Why EduHub helps students</span>
        <h2>Everything needed for learning and preparation</h2>
        <p>
          EduHub is designed to reduce the time students spend searching for information by combining material,
          previous exam papers, and announcements in one workflow.
        </p>
        <ul class="checklist">
          <li>Find course information and notices from one dashboard.</li>
          <li>Access study materials and exam papers without jumping between portals.</li>
          <li>Track announcements and deadlines in real time.</li>
        </ul>
      </div>
      <div class="feature-band__media">
        <img src={mona.src} alt="EduHub overview illustration" />
      </div>
    </section>

    <section class="story-grid" id="content-sources">
      <div class="section-heading">
        <span class="eyebrow">Feature overview</span>
        <h2>Core sections inside EduHub</h2>
        <p>
          Students can move through information, materials, exam preparation, and announcements from one central place.
        </p>
      </div>

      <div class="source-grid">
        {sourceGroups.map((group) => (
          <article class="source-card">
            <span class="eyebrow">{group.eyebrow}</span>
            <h3>{group.title}</h3>
            <p>{group.description}</p>
            <ul>
              {group.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
            <a href={group.link} target="_blank" rel="noreferrer">{group.linkLabel}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="closing-callout">
      <div class="closing-callout__copy">
        <span class="eyebrow">EduHub promise</span>
        <h2>One student app for learning, preparation, and updates.</h2>
        <p>
          EduHub keeps every essential student resource together so learners can focus on progress instead of
          searching across multiple systems.
        </p>
        <div class="source-links">
          <a href="#recent-updates">Information & resources</a>
          <a href="#content-sources">Core feature sections</a>
          <a href="#latest-release">Latest EduHub update</a>
        </div>
      </div>
      <div class="closing-callout__art">
        <img src={ducky.src} alt="EduHub closing illustration" />
      </div>
    </section>
  </main>
</BaseLayout>
